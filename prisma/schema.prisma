// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExerciseType {
  MULTIPLE_CHOICE
  NUMERIC_INPUT
  EXPRESSION_ENTRY
  GRAPHING
  MULTI_STEP
  DRAG_DROP
}

enum AchievementType {
  STREAK
  MASTERY
  COMPLETION
  XP_MILESTONE
  SOCIAL
  SPECIAL
}

enum ContentType {
  LESSON
  VIDEO
  EXERCISE
  VISUALIZATION
  CALCULATOR
  QUIZ
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(STUDENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Profile
  grade         String?   // K, 1, 2, ..., 12
  bio           String?
  timezone      String?   @default("UTC")
  language      String?   @default("en")
  
  // Gamification
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?
  
  // Settings
  theme         String    @default("system") // light, dark, system
  notifications Boolean   @default(true)
  publicProfile Boolean   @default(false)
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  progress      UserProgress[]
  attempts      ExerciseAttempt[]
  achievements  UserAchievement[]
  forumPosts    ForumPost[]
  forumReplies  ForumReply[]
  forumVotes    ForumVote[]
  badges        UserBadge[]
  studyGroups   StudyGroupMember[]
  assignments   Assignment[] @relation("StudentAssignments")
  createdAssignments Assignment[] @relation("TeacherAssignments")
  classrooms    ClassroomMember[]
  ownedClassrooms Classroom[] @relation("ClassroomOwner")
  ownedStudyGroups StudyGroup[] @relation("StudyGroupOwner")
  userNotifications Notification[]
  dailyChallengeCompletions UserDailyChallenge[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Learning preferences
  learningGoals  String[] @default([])
  interests      String[] @default([])
  preferredPace  String?  @default("normal") // slow, normal, fast
  
  // Privacy
  showProgress   Boolean  @default(true)
  showAchievements Boolean @default(true)
  allowMessages  Boolean  @default(false)
  
  // Parent/Guardian (for COPPA)
  parentEmail    String?
  parentConsent  Boolean  @default(false)
  consentDate    DateTime?
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  color       String?  @default("#2563eb")
  order       Int      @default(0)
  grade       String?  // K, 1, 2, ..., 12
  domain      String?  // e.g., "algebra", "geometry", "statistics"
  cluster     String?  // Common Core cluster
  standard    String?  // Common Core standard code
  parentId    String?
  parent      Topic?   @relation("TopicHierarchy", fields: [parentId], references: [id])
  children    Topic[]  @relation("TopicHierarchy")
  prerequisites Topic[] @relation("TopicPrerequisites")
  prerequisiteFor Topic[] @relation("TopicPrerequisites")
  subtopics   Subtopic[]
  lessons     Lesson[]
  exercises   Exercise[]
  visualizations Visualization[]
  progress    UserProgress[]
  forumPosts  ForumPost[]
  studyGroups StudyGroup[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([grade])
  @@index([domain])
  @@index([parentId])
}

model Subtopic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  exercises   Exercise[]
  progress    UserProgress[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([topicId])
}

model Lesson {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String?     @db.Text
  content       String      @db.Text // Markdown with KaTeX
  videoUrl      String?     // Khan Academy or other video URL
  videoProvider String?     // "khan-academy", "youtube", "custom"
  videoId       String?     // Video ID for embedding
  duration      Int?        // Estimated minutes
  order         Int         @default(0)
  difficulty    Difficulty  @default(MEDIUM)
  xpReward      Int         @default(50)
  topicId       String
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId    String?
  subtopic      Subtopic?   @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  prerequisites Lesson[]    @relation("LessonPrerequisites")
  prerequisiteFor Lesson[] @relation("LessonPrerequisites")
  exercises     Exercise[]
  visualizations Visualization[]
  progress      UserProgress[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  publishedAt   DateTime?
  isPublished   Boolean     @default(false)
  
  @@index([topicId])
  @@index([subtopicId])
  @@index([isPublished])
}

model Exercise {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?       @db.Text
  content       String        @db.Text // Problem statement with KaTeX
  type          ExerciseType
  difficulty    Difficulty    @default(MEDIUM)
  xpReward      Int           @default(25)
  timeLimit     Int?          // Seconds, null = no limit
  hints         String[]      @default([]) // Progressive hints
  solution      String        @db.Text // Worked solution with KaTeX
  explanation   String?       @db.Text // Additional explanation
  topicId       String
  topic         Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId    String?
  subtopic      Subtopic?     @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  lessonId      String?
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  options       Json?         // For multiple choice: [{text, isCorrect, explanation}]
  correctAnswer String?       // For numeric/expression entry
  answerFormat  String?       // Regex or format hint
  variables     Json?         // For generated variants
  tags          String[]      @default([])
  attempts      ExerciseAttempt[]
  assignments   Assignment[]
  dailyChallenges DailyChallenge[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?
  isPublished   Boolean       @default(false)
  
  @@index([topicId])
  @@index([lessonId])
  @@index([difficulty])
  @@index([isPublished])
}

model ExerciseAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answer      String   @db.Text
  isCorrect   Boolean
  xpEarned    Int      @default(0)
  timeSpent   Int      // Seconds
  hintsUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  
  @@index([userId, exerciseId])
  @@index([userId, createdAt])
  @@index([exerciseId, isCorrect])
}

model UserProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId      String?
  subtopic        Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  lessonId        String?
  lesson          Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mastery         Float    @default(0) // 0-100
  status          String   @default("not_started") // not_started, in_progress, completed, mastered
  timeSpent       Int      @default(0) // Total seconds
  lastAttemptedAt DateTime?
  completedAt     DateTime?
  masteredAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([userId, lessonId])
  @@unique([userId, topicId])
  @@unique([userId, subtopicId])
  @@index([userId, status])
  @@index([userId, mastery])
}

model Visualization {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  type        String   // "graph", "geometry", "algebra-tiles", "probability", "statistics", "fraction"
  config      Json     // Configuration for the visualization
  component   String   // React component name
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([topicId])
  @@index([type])
}

model CalculatorTool {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  type        String   // "graphing", "scientific", "matrix", "statistics", "unit-converter", "fraction"
  config      Json     // Tool-specific configuration
  component   String   // React component name
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String         @db.Text
  type        AchievementType
  icon        String
  color       String         @default("#2563eb")
  xpReward    Int            @default(0)
  criteria    Json           // { type: "streak", value: 7 }, { type: "mastery", topic: "algebra", value: 90 }
  isSecret    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Int         @default(0)
  completed     Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  
  @@unique([userId, achievementId])
  @@index([userId, completed])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  icon        String
  color       String   @default("#2563eb")
  rarity      String   @default("common") // common, rare, epic, legendary
  criteria    Json     // How to earn this badge
  createdAt   DateTime @default(now())
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())
  
  @@unique([userId, badgeId])
}

model ForumPost {
  id        String      @id @default(cuid())
  title     String
  slug      String      @unique
  content   String      @db.Text
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String?
  topic     Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tags      String[]    @default([])
  isPinned  Boolean     @default(false)
  isLocked  Boolean     @default(false)
  views     Int         @default(0)
  replies   ForumReply[]
  votes     ForumVote[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  @@index([userId])
  @@index([topicId])
  @@index([createdAt])
}

model ForumReply {
  id        String     @id @default(cuid())
  content   String     @db.Text
  postId    String
  post      ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ForumReply? @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children  ForumReply[] @relation("ReplyThread")
  votes     ForumVote[]
  isAccepted Boolean   @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  @@index([postId])
  @@index([userId])
}

model ForumVote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      ForumPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  value     Int      // 1 or -1
  createdAt DateTime @default(now())
  
  @@unique([userId, postId])
  @@unique([userId, replyId])
}

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  ownerId     String
  owner       User     @relation("StudyGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  isPrivate   Boolean  @default(false)
  inviteCode  String?  @unique
  members     StudyGroupMember[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model StudyGroupMember {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId    String
  group      StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role       String     @default("member") // member, moderator, owner
  joinedAt   DateTime   @default(now())
  
  @@unique([userId, groupId])
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  ownerId     String
  owner       User     @relation("ClassroomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grade       String?
  subject     String?
  inviteCode  String   @unique
  members     ClassroomMember[]
  assignments Assignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([ownerId])
}

model ClassroomMember {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroomId String
  classroom  Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  role       String    @default("student") // student, teacher, ta
  joinedAt   DateTime  @default(now())
  
  @@unique([userId, classroomId])
}

model Assignment {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User      @relation("TeacherAssignments", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo    User[]    @relation("StudentAssignments")
  exercises     Exercise[]
  dueDate       DateTime?
  assignedAt    DateTime @default(now())
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([classroomId])
  @@index([dueDate])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  xpBonus     Int      @default(50)
  completions UserDailyChallenge[]
  createdAt   DateTime @default(now())
}

model UserDailyChallenge {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId      String
  challenge        DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completed        Boolean        @default(false)
  completedAt      DateTime?
  xpEarned         Int            @default(0)
  
  @@unique([userId, challengeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // achievement, streak, assignment, message, system
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId, read])
  @@index([userId, createdAt])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
